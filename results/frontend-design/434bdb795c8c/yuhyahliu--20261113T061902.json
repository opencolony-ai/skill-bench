px;padding:24px;display:grid;gap:20px}\n.hours h2,h2.t{margin:0 0 .6rem;font-size:1.7rem}\ntable{border-collapse:collapse;width:100%;font-family:system-ui,sans-serif;font-variant-numeric:tabular-nums}\nth,td{text-align:left;padding:8px 0;border-bottom:1px solid var(--line);font-weight:400}\nth{font-weight:600}\ntd{text-align:right}\ntr.closed{color:var(--muted)}\n.where p{margin:0 0 .6rem}\n@media(min-width:700px){.hours{grid-template-columns:1fr 1fr;gap:40px}}\nsection{margin:3rem 0}\nsection p{max-width:38rem}\n.join{background:var(--green);color:var(--on-green);border-radius:6px;padding:32px 24px;margin:3rem 0}\n.join h2{margin:0 0 .6rem;font-size:1.8rem}\n.join p{margin:0 0 1.2rem;max-width:36rem}\n.join .btn{background:var(--on-green);color:var(--green)}\n.join .btn:hover{background:#fff}\n.join a:focus-visible{outline-color:var(--on-green)}\nfooter{border-top:3px double var(--line);padding:24px 0 40px;font:.9rem system-ui,sans-serif;color:var(--muted)}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div class=\"logo\">Fernhill Reading Room</div>\n    <a href=\"#hours\">Opening hours</a>\n  </header>\n  <main>\n    <h1>A library in the old railway station.</h1>\n    <p class=\"lede\">Fernhill Reading Room is a volunteer-run lending library. Borrow books where the trains used to stop, and read a while by the platform windows.</p>\n    <div class=\"actions\">\n      <a class=\"btn\" href=\"#join\">Become a member</a>\n      <a class=\"btn alt\" href=\"#hours\">See opening hours</a>\n    </div>\n\n    <div class=\"hours\" id=\"hours\">\n      <div>\n        <h2>Opening hours</h2>\n        <table>\n          <tr><th scope=\"row\">Monday</th><td>Closed</td></tr>\n          <tr><th scope=\"row\">Tuesday</th><td>10:00–17:00</td></tr>\n          <tr><th scope=\"row\">Wednesday</th><td>10:00–17:00</td></tr>\n          <tr><th scope=\"row\">Thursday</th><td>10:00–17:00</td></tr>\n          <tr><th scope=\"row\">Friday</th><td>10:00–17:00</td></tr>\n          <tr><th scope=\"row\">Saturday</th><td>10:00–17:00</td></tr>\n          <tr class=\"closed\"><th scope=\"row\">Sunday</th><td>Closed</td></tr>\n        </table>\n      </div>\n      <div class=\"where\">\n        <h2>Find us</h2>\n        <p>In the former Fernhill railway station building. Look for the platform canopy.</p>\n        <p>Everyone is welcome to come in and browse. Membership is for borrowing.</p>\n      </div>\n    </div>\n\n    <section>\n      <h2 class=\"t\">Run by volunteers, for the neighbourhood</h2>\n      <p>The shelves are stocked by donation and kept by people who love books. Come in, ask what's good, and take something home.</p>\n    </section>\n\n    <div class=\"join\" id=\"join\">\n      <h2>Become a member</h2>\n      <p>Join to borrow from the collection. Ask at the desk during opening hours and a volunteer will sign you up.</p>\n      <a class=\"btn\" href=\"#hours\">Check when we're open</a>\n    </div>\n  </main>\n  <footer>Fernhill Reading Room · Tuesday–Saturday, 10:00–17:00 · Volunteer-run</footer>\n</div>\n</body>\n</html>\n"
