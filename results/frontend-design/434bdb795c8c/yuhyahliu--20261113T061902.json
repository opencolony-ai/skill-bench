m 0}\nh2.s{font:600 clamp(1.7rem,5vw,2.4rem)/1.1 var(--sans);margin:0 0 1rem;letter-spacing:-.01em}\np{max-width:36rem}\n.about{display:grid;gap:2rem}\n@media(min-width:50rem){.about{grid-template-columns:1fr 1fr;gap:4rem}}\n.facts{margin:0;padding:0;list-style:none}\n.facts li{padding:.75rem 0;border-bottom:1px solid #c9d0c6}\n.facts li:first-child{border-top:1px solid #c9d0c6}\n.join{background:var(--paper)}\n.ticket{background:var(--white);border:2px solid var(--green);border-radius:.5rem;max-width:38rem;display:grid;position:relative;overflow:hidden}\n.ticket .head{background:var(--green);color:var(--white);padding:.8rem 1.25rem;font-weight:600}\n.ticket form{padding:1.25rem;display:grid;gap:1rem}\nlabel{display:grid;gap:.3rem;font-weight:600;font-size:1rem}\ninput,select{font:inherit;padding:.7rem .75rem;border:2px solid #7d8f85;border-radius:.3rem;background:#fff;color:var(--ink);min-height:3rem}\ninput:focus-visible,select:focus-visible{outline-offset:1px;border-color:var(--green)}\n.hint{font-weight:400;color:var(--muted);font-size:.95rem}\n.ticket .btn{background:var(--green);color:#fff;justify-self:start}\n.ticket .btn:hover{background:var(--deep)}\n.find{display:grid;gap:.25rem}\nfooter{background:var(--deep);color:#c3d5ca;padding:2rem 0;font-size:1rem}\nfooter p{margin:.2rem 0}\n.row{animation:flip .6s ease-out both}\n.row:nth-child(2){animation-delay:.1s}.row:nth-child(3){animation-delay:.2s}.row:nth-child(4){animation-delay:.3s}.row:nth-child(5){animation-delay:.4s}\n@keyframes flip{from{opacity:0;transform:translateY(-6px)}}\n@media(prefers-reduced-motion:reduce){.row{animation:none}}\n</style>\n</head>\n<body>\n<header class=\"hero\">\n <div class=\"wrap\">\n  <p class=\"name\">Fernhill Reading Room</p>\n  <h1>Borrow a book at the old station.</h1>\n  <p class=\"lead\">A lending library run by volunteers in Fernhill's former railway station. Come in, browse the shelves and take something home.</p>\n  <div class=\"board\" role=\"region\" aria-label=\"Opening hours\">\n   <h2>Opening hours</h2>\n   <dl>\n    <div class=\"row\"><dt>Tue–Sat</dt><dd>10:00–17:00</dd></div>\n    <div class=\"row off\"><dt>Sun</dt><dd>Closed</dd></div>\n    <div class=\"row off\"><dt>Mon</dt><dd>Closed</dd></div>\n   </dl>\n  </div>\n  <a class=\"btn\" href=\"#join\">Become a member</a>\n </div>\n</header>\n\n<main>\n<section>\n <div class=\"wrap about\">\n  <div>\n   <h2 class=\"s\">Housed in the booking hall</h2>\n   <p>The shelves stand where the ticket windows used to be, and the waiting room is now the reading room. Sit by the stove, or borrow a book and read it at home.</p>\n  </div>\n  <ul class=\"facts\">\n   <li>Members borrow books to take home.</li>\n   <li>Everyone is welcome to read in the building.</li>\n   <li>Run entirely by volunteers.</li>\n  </ul>\n </div>\n</section>\n\n<section class=\"join\" id=\"join\">\n <div class=\"wrap\">\n  <h2 class=\"s\">Become a member</h2>\n  <p>Tell us who you are and we'll have your card ready. Collect it at the desk on your next visit, Tuesday to Saturday.</p>\n  <div class=\"ticket\">\n   <div class=\"head\">Membership application</div>\n   <form action=\"mailto:hello@fernhillreadingroom.example\" method=\"post\" enctype=\"text/plain\">\n    <label>Full name<input name=\"name\" autocomplete=\"name\" required></label>\n    <label>Email address<input type=\"email\" name=\"email\" autocomplete=\"email\" required></label>\n    <label>Phone number <span class=\"hint\">Optional</span><input type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label>\n    <button class=\"btn\" type=\"submit\">Send application</button>\n   </form>\n  </div>\n </div>\n</section>\n</main>\n<footer><div class=\"wrap\"><p>Fernhill Reading Room, the old railway station.</p><p>Open Tuesday to Saturday, 10:00–17:00.</p></div></footer>\n</body>\n</html>\n"
