0%;mask:conic-gradient(from -45deg at bottom,#0000,#000 1deg 89deg,#0000 90deg) 50%/20px 100%;\n transform:rotate(1deg);max-width:26rem}\n.slip h2{font:700 1.05rem var(--mono);margin:0 0 .15rem}\n.slip .sub{color:var(--muted);margin:0 0 1rem}\n.slip table{width:100%;border-collapse:collapse}\n.slip td{padding:.3rem 0;border-bottom:1px dashed var(--line)}\n.slip td:last-child{text-align:right}\n.slip .ok{color:var(--green)}\n.slip .tot td{border-bottom:0;border-top:2px solid var(--ink);font-weight:700;padding-top:.6rem}\n.slip .done{margin-top:1rem;background:var(--greenbg);color:#14553b;padding:.7rem .8rem;font-weight:700;font-family:var(--sans)}\n@media(min-width:56rem){.hero{grid-template-columns:1.2fr 1fr;align-items:center;padding:3rem 0 5rem}}\nsection.band{background:var(--navy);color:#fff;padding:4rem 0}\nsection.plain{padding:4rem 0}\nh2.big{font:700 clamp(1.7rem,5vw,2.5rem)/1.1 var(--slab);margin:0 0 1.5rem}\n.cols{display:grid;gap:2rem}\n@media(min-width:50rem){.cols{grid-template-columns:repeat(3,1fr);gap:2.5rem}}\n.cols h3{font:700 1.2rem var(--slab);margin:0 0 .4rem}\n.cols p{margin:0;max-width:30rem}\n.band .cols p{color:#d3dbe8}\n.band h3{color:#f1c76f}\n.steps{display:grid;gap:1.5rem;max-width:44rem;margin:0;padding:0;list-style:none;counter-reset:s}\n.steps li{counter-increment:s;padding-left:3.2rem;position:relative}\n.steps li::before{content:counter(s);position:absolute;left:0;top:-.1rem;width:2.2rem;height:2.2rem;border-radius:50%;background:var(--gold);color:var(--ink);font:700 1.1rem/2.2rem var(--slab);text-align:center}\n.steps b{display:block;font-family:var(--slab);font-size:1.15rem}\n.final{background:var(--white);border-top:4px solid var(--gold);padding:4rem 0;text-align:left}\n.final p{max-width:34rem}\nfooter{padding:1.5rem 0;color:var(--muted);font-size:.9rem}\n.slip{animation:in .9s ease-out both}\n@keyframes in{from{opacity:0;transform:translateY(14px) rotate(1deg)}}\n@media(prefers-reduced-motion:reduce){.slip{animation:none}}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n <nav><a class=\"brand\" href=\"#\">Ledgerly</a><a class=\"btn sm\" href=\"#trial\">Start free trial</a></nav>\n <header class=\"hero\">\n  <div>\n   <h1>Your card payments, matched before the first loaf is out.</h1>\n   <p class=\"lead\">Ledgerly reads your card sales and your bank deposits overnight, matches them, and tells you only what doesn't add up.</p>\n   <a class=\"btn\" href=\"#trial\">Start your 30-day free trial</a>\n   <p class=\"fine\">No card needed to start. Cancel any time.</p>\n  </div>\n  <div class=\"slip\" role=\"img\" aria-label=\"Example morning report: 47 card payments from Tuesday matched to a bank deposit of £612.40, with one fee difference flagged for review\">\n   <h2>Tuesday's card sales</h2>\n   <p class=\"sub\">Checked 04:58 this morning</p>\n   <table aria-hidden=\"true\">\n    <tr><td>Counter, 47 payments</td><td>£641.20</td></tr>\n    <tr><td>Card fees</td><td>−£11.54</td></tr>\n    <tr><td>Refund, sourdough</td><td>−£17.26</td></tr>\n    <tr class=\"tot\"><td>Bank deposit</td><td class=\"ok\">£612.40 ✓</td></tr>\n   </table>\n   <p class=\"done\" aria-hidden=\"true\">Everything matches. Nothing to do.</p>\n  </div>\n </header>\n</div>\n\n<section class=\"band\">\n <div class=\"wrap\">\n  <h2 class=\"big\">What it does while you bake</h2>\n  <div class=\"cols\">\n   <div><h3>Reconciles card payments</h3><p>Each day's sales are matched to the deposit that lands in your bank, including fees and refunds.</p></div>\n   <div><h3>Flags only the odd one out</h3><p>If a deposit is short, you get one line saying which day and by how much.</p></div>\n   <div><h3>Keeps the books tidy</h3><p>Wholesale invoices, flour bills and wages sit in one place, ready for your accountant.</p></div>\n  </div>\n </div>\n</section>\n\n<section class=\"plain\">\n <div class=\"wrap\">\n  <h2 class=\"big\">Set up before your next shift</h2>\n  <ol class=\"steps\">\n   <li><b>Connect your card provider</b>Sign in once. Ledgerly only reads your sales.</li>\n   <li><b>Connect your bank</b>Read-only access. We can't move money.</li>\n   <li><b>Read your first report</b>Tomorrow morning, it's waiting on your phone.</li>\n  </ol>\n </div>\n</section>\n\n<section class=\"final\" id=\"trial\">\n <div class=\"wrap\">\n  <h2 class=\"big\">Try Ledgerly free for 30 days</h2>\n  <p>See a full month of card payments reconciled for you. If it isn't saving you time, walk away.</p>\n  <a class=\"btn\" href=\"mailto:hello@ledgerly.example?subject=Start%20my%2030-day%20trial\">Start your 30-day free trial</a>\n </div>\n</section>\n<footer><div class=\"wrap\">Ledgerly, bookkeeping for independent bakeries.</div></footer>\n</body>\n</html>\n"
